# Required.
MODEL="/path/to/model"
# Tokenizer used by vllm bench serve to build random prompts. Keep it pointed
# at the local model path to avoid HuggingFace lookup for SERVED_MODEL_NAME.
BENCH_TOKENIZER="${MODEL}"

# Modes: pull, layerwise, or both.
MODES="pull layerwise"

# One NPU per process by default. For TP>1, list comma-separated devices.
PREFILL_DEVICES="0"
DECODE_DEVICES="1"
TP_SIZE=1

HOST="127.0.0.1"
PREFILL_PORT=8100
DECODE_PORT=8200
PROXY_PORT=9000
PREFILL_KV_PORT=30000
DECODE_KV_PORT=30100

MAX_MODEL_LEN=20000
MAX_NUM_BATCHED_TOKENS=20000
MAX_NUM_SEQS=64
GPU_MEMORY_UTILIZATION=0.9
SERVED_MODEL_NAME="pd-transfer-model"

# Benchmark matrix.
INPUT_LENS="1024 4096 8192 16384"
OUTPUT_LENS="32 128"
CONCURRENCIES="1 4 8 16"
NUM_FOLDS=20
RANDOM_PREFIX_LEN=0

RESULT_ROOT="results/pd_transfer"

# SLOs used by parse_pd_trace.py to compute serve-level goodput.
TTFT_P99_SLO_MS=1000
TPOT_P99_SLO_MS=50

# Optional NPU utilization sampling. The sampler runs during each mode and
# aggregates samples into per-case P/D utilization balance during parsing.
ENABLE_NPU_UTIL_SAMPLING=1
NPU_UTIL_SAMPLE_INTERVAL_SEC=1

# Extra args are appended as-is.
COMMON_VLLM_ARGS="--seed 1024 --trust-remote-code --enforce-eager --no-enable-prefix-caching"
PREFILL_EXTRA_ARGS=""
DECODE_EXTRA_ARGS=""
BENCH_EXTRA_ARGS="--ignore-eos --percentile-metrics ttft,tpot,itl,e2el --metric-percentiles 50,90,99"

# Environment commonly used on Ascend. Override these as needed.
HCCL_EXEC_TIMEOUT=204
HCCL_CONNECT_TIMEOUT=120
TASK_QUEUE_ENABLE=1
VLLM_USE_V1=1
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
